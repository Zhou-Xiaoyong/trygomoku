# ==========================================
# Cloudflare Pages Headers — trygomoku.com
# ==========================================
#
# ✅ PRODUCTION MODE — 长效缓存配置
#    HTML 缓存 1 小时（过期重新验证，内容更新最多 1 小时内生效）；
#    CSS / JS 缓存 1 周；图片缓存 1 年（immutable）；
#    i18n / manifest / sitemap / robots 缓存 1 天。
#    站点仍在迭代时若要立即生效，可在 Cloudflare 后台做一次 Custom Purge。
#

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=()

# HTML — 根目录索引、语言子站目录索引、以及所有 .html 页面，缓存 1 小时
/
  Cache-Control: public, max-age=3600, must-revalidate

/**/
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# CSS — 缓存 1 周
/css/*
  Cache-Control: public, max-age=604800, must-revalidate

# JS — 缓存 1 周
/js/*
  Cache-Control: public, max-age=604800, must-revalidate

# Images — 缓存 1 年（immutable；更新图片请改名或 Purge）
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# i18n JSON — 翻译可能更新，缓存 1 天
/i18n/*
  Cache-Control: public, max-age=86400, must-revalidate

# Manifest — 缓存 1 天
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate

# Sitemap & robots — 缓存 1 天
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
